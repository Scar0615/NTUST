+// hw2
+void mosquitto_puback_v5_callback_set(struct mosquitto *mosq, void (*on_puback)(struct mosquitto *, void *, int, int, const mosquitto_property *props))
+{
+	pthread_mutex_lock(&mosq->callback_mutex);
+	mosq->on_puback = on_puback;
+	pthread_mutex_unlock(&mosq->callback_mutex);
+}
