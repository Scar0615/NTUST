+void my_puback_callback(struct mosquitto *mosq, void *obj, int mid, int reason_code, const mosquitto_property *properties) {
+    printf("PUBACK received for message ID: %d, reason code: %d\n", mid, reason_code);
+
+	// Ignore unused parameters
+    (void)mosq;
+    (void)obj;
+    (void)properties;
+
+    // Call the timestamp function to print the time of PUBACK receipt
+    time_t now;
+    struct tm *ts;
+    char buf[80];
+
+    // Get the current time
+    time(&now);
+
+    // Format the time as "YYYY-MM-DD HH:MM:SS"
+    ts = localtime(&now);
+    strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", ts);
+
+    // Print the timestamp
+    printf("PUBACK received at: %s\n", buf);
+}
